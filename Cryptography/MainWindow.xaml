<Window x:Class="Cryptography.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cryptography"
        Title="Crypto Studio" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkBlue.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Custom TabItem Style to match the screenshot -->
            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid x:Name="Panel">
                                <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ContentSource="Header"
                                        Margin="20,10"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Panel" Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter TargetName="Panel" Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Tab Headers -->
            <RowDefinition Height="Auto"/> <!-- Header Title -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- 1. Custom Tabs Area -->
        <Border Grid.Row="0" Background="#050B10" BorderBrush="#2A4365" BorderThickness="0,0,0,1">
            <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0" Margin="10,10,0,0">
                <TabItem Header="producer">
                    <!-- Content is loaded in code-behind or handled by visibility -->
                </TabItem>
                <TabItem Header="consumer">
                    
                </TabItem>
            </TabControl>
        </Border>

        <!-- 2. Header Title (Shared) -->
        <Border Grid.Row="1" Margin="20,10,20,5" Padding="0,10" BorderBrush="#2A4365" BorderThickness="0,0,0,1">
            
        </Border>

        <!-- 3. Tab Content Area -->
        <Grid Grid.Row="2" Margin="20">
            <!-- We stack both views but control visibility based on tab selection 
                 (Or simply put them inside the TabControl.Content if not using the custom header trick) -->
            
            <!-- Better approach with the TabControl directly: -->
            <TabControl x:Name="ContentTabs" BorderThickness="0" Background="Transparent" Margin="-20,-75,-20,-20">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/> <!-- Hide default headers -->
                    </Style>
                </TabControl.Resources>
                
                <!-- Producer Tab Content -->
                <TabItem>
                    <local:CryptoOperationView x:Name="ProducerView" Margin="20"/>
                </TabItem>
                
                <!-- Consumer Tab Content -->
                <TabItem>
                    <local:CryptoOperationView x:Name="ConsumerView" Margin="20"/>
                </TabItem>
            </TabControl>
        </Grid>
        
        <!-- Overlay the custom header logic -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="Black">
             <Button Content="producer" Click="SwitchToProducer" 
                     x:Name="BtnProducer" Width="100" Height="30" Background="White" Foreground="Black" FontWeight="Bold" BorderThickness="0"/>
             <Button Content="consumer" Click="SwitchToConsumer" 
                     x:Name="BtnConsumer" Width="100" Height="30" Background="Transparent" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>